# Keep `npx wrangler --version` machine-readable.
#
# At npm's default loglevel (notice) every `npx` run prints two "npm notice run"
# lines ahead of the real output, the first of which contains THIS package's
# version. pywrangler parses that output to check the wrangler version and so
# reads "0.0.0" instead of the real one, then refuses to start with
# "wrangler version at least 4.127.1 required, have 0.0.0".
loglevel=warn
