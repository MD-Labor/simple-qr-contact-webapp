# Copy to .dev.vars (gitignored) and fill in. scripts/deploy.sh pushes that file to the
# deployed Worker with `wrangler secret bulk`. The Turnstile *site* key is public and lives
# in the login step's data-sitekey attribute, not here.
SESSION_SECRET=change-me
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
